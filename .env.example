# 复制为 .env 后填写；程序只读进程环境变量，不自动加载本文件。
# 所有值均为占位符。真实密钥绝不入库、不写入镜像。

# ---------- 服务与 API 密钥 ----------
SERVICE_HOST=0.0.0.0
SERVICE_PORT=8000
SERVICE_API_KEYS=[{"key":"exec-key-change-me","user":"alice","role":"executor"},{"key":"admin-key-change-me","user":"admin","role":"admin"}]
SERVICE_MAX_CONCURRENT_TASKS=4
SERVICE_MAX_REQUESTS_PER_MINUTE=30
SERVICE_MAX_INPUT_CHARS=2000
SERVICE_TASK_RETENTION_DAYS=30

# ---------- 数据库与预算 ----------
COLLAB_DB_PATH=data/collab.db
COLLAB_SEED_DIR=seed_data
COLLAB_MAX_TOTAL_CALLS=50
COLLAB_MAX_CALLS_PER_TASK=12
COLLAB_MAX_PROMPT_CHARS=30000
COLLAB_MAX_COMPLETION_TOKENS=6000
COLLAB_REVISION_LIMIT=0
COLLAB_LOG_LEVEL=INFO

# ---------- 模型密钥（占位符）----------
DEEPSEEK_API_BASE=https://api.deepseek.com/v1
DEEPSEEK_API_KEY=sk-replace-me
PLANNER_MODEL=deepseek-flash

QWEN_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_API_KEY=sk-replace-me
BUSINESS_MODEL=qwen3.8-flash
POLICY_MODEL=qwen3.8-flash

KIMI_API_BASE=https://api.moonshot.cn/v1
KIMI_API_KEY=sk-replace-me
AUDITOR_MODEL=kimi-k2.7-code
KIMI_MIN_INTERVAL_SECONDS=21
